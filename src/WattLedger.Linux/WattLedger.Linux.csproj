<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WattLedger.Core/WattLedger.Core.csproj" />
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Wayland" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Tmds.DBus.Protocol" Version="0.94.1" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/**/*.svg" />
    <Compile Include="../WattLedger.Desktop/ChartSeries.cs" Link="Shared/ChartSeries.cs" />
    <Compile Include="../WattLedger.Desktop/PowerChartLayout.cs" Link="Shared/PowerChartLayout.cs" />
    <Compile Include="../WattLedger.Desktop/DashboardDataLoader.cs" Link="Shared/DashboardDataLoader.cs" />
    <Compile Include="../WattLedger.Desktop/ReportRefreshGate.cs" Link="Shared/ReportRefreshGate.cs" />
    <Compile Include="../WattLedger.Desktop/ChartInteractionState.cs" Link="Shared/ChartInteractionState.cs" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../WattLedger.Desktop/ThemePreference.cs" Link="ThemePreference.cs" />
  </ItemGroup>
</Project>
