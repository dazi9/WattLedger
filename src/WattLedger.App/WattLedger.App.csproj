<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WattLedger.Core\WattLedger.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>WattLedger</AssemblyName>
    <RootNamespace>WattLedger.App</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../WattLedger.Desktop/AppText.cs" Link="Shared/AppText.cs" />
    <Compile Include="../WattLedger.Desktop/LanguagePreference.cs" Link="Shared/LanguagePreference.cs" />
    <EmbeddedResource Include="../WattLedger.Desktop/Strings.zh-CN.json" LogicalName="WattLedger.Desktop.Strings.zh-CN.json" WithCulture="false" />
    <Compile Include="../WattLedger.Desktop/ThemePreference.cs" Link="ThemePreference.cs" />
    <Compile Include="../WattLedger.Desktop/ChartGestureScale.cs" Link="Shared/ChartGestureScale.cs" />
    <Compile Include="../WattLedger.Desktop/ChartSeries.cs" Link="Shared/ChartSeries.cs" />
    <Compile Include="../WattLedger.Desktop/PowerChartLayout.cs" Link="Shared/PowerChartLayout.cs" />
    <Compile Include="../WattLedger.Desktop/DashboardDataLoader.cs" Link="Shared/DashboardDataLoader.cs" />
    <Compile Include="../WattLedger.Desktop/ReportRefreshGate.cs" Link="Shared/ReportRefreshGate.cs" />
    <Compile Include="../WattLedger.Desktop/ChartInteractionState.cs" Link="Shared/ChartInteractionState.cs" />
  </ItemGroup>
</Project>
