<Window x:Class="WattLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:WattLedger.App"
        Title="WattLedger"
        Height="800"
        Width="1120"
        MinHeight="640"
        MinWidth="960"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <StackPanel>
                <TextBlock Text="WattLedger" Style="{StaticResource TitleText}" />
                <TextBlock Text="Local-first battery energy journal" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
            </StackPanel>

            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="14,7">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="8" Height="8" Fill="{Binding StateBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding StateText}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="4" Margin="0,22,0,0">
            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="LIVE POWER" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding PowerText}" Style="{StaticResource MetricValue}" Foreground="{Binding PowerBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding PowerDetailText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="BATTERY" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding BatteryText}" Style="{StaticResource MetricValue}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding BatteryDetailText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="TIME LEFT" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TimeLeftText}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource BlueBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TimeLeftDetailText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="TODAY" Style="{StaticResource MetricLabel}" />
                    <TextBlock Text="{Binding TodayEnergyText}" Style="{StaticResource MetricValue}" Foreground="{DynamicResource GreenBrush}" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding TodayDetailText}" Style="{StaticResource SubtleText}" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Power &amp; battery · today" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Power: + discharge / − charging · blue dashed line: battery %" Style="{StaticResource SubtleText}" Margin="0,4,0,6" />
                <WrapPanel>
                    <Button x:Name="PanModeButton" Content="Pan ✓" Click="PanMode_Click" />
                    <Button x:Name="SelectModeButton" Content="Select points" Click="SelectMode_Click" />
                    <Button x:Name="EarlierButton" Content="← Earlier" Click="Earlier_Click" />
                    <Button x:Name="LaterButton" Content="Later →" Click="Later_Click" />
                    <Button Content="+" ToolTip="Zoom in" Click="ZoomIn_Click" />
                    <Button Content="−" ToolTip="Zoom out" Click="ZoomOut_Click" />
                    <Button Content="Fit today" Click="ResetChart_Click" />
                    <Button x:Name="FollowButton" Content="Following live" Click="FollowLive_Click" />
                    <Button Content="Fit selection" Click="FitSelection_Click" />
                    <Button Content="Clear selection" Click="ClearSelection_Click" />
                </WrapPanel>
                <TextBlock x:Name="ChartRange" Style="{StaticResource SubtleText}" Margin="0,6,0,0" />
                <local:PowerChart x:Name="Chart" Height="210" Margin="0,4,0,0" />
                <TextBlock Text="Drag to pan · Select points to measure · wheel to zoom · horizontal scroll / arrow keys to pan" Style="{StaticResource SubtleText}" TextWrapping="Wrap" />
                <WrapPanel Margin="0,8,0,0">
                    <TextBlock Text="From" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SelectionStart" Width="85" Padding="6,4" Margin="0,0,12,0" ToolTip="Selection start: HH:mm:ss" AutomationProperties.Name="Selection start time" />
                    <TextBlock Text="To" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="SelectionEnd" Width="85" Padding="6,4" Margin="0,0,12,0" ToolTip="Selection end: HH:mm:ss" AutomationProperties.Name="Selection end time" />
                    <Button Content="Calculate" Click="CalculateSelection_Click" />
                </WrapPanel>
                <TextBlock x:Name="SelectionSummary" Text="Choose Select points and drag, or enter two times to calculate a range."
                           Style="{StaticResource SubtleText}" TextWrapping="Wrap" Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,12,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <TextBlock Text="Today's ledger" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding StatusText}"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Style="{StaticResource SubtleText}" />
                </Grid>

                <DataGrid x:Name="SessionsGrid" Height="190"
                          Grid.Row="1"
                          Margin="0,8,0,0"
                          ItemsSource="{Binding Sessions}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="START" Binding="{Binding Start}" Width="90" />
                        <DataGridTextColumn Header="END" Binding="{Binding End}" Width="90" />
                        <DataGridTextColumn Header="STATE" Binding="{Binding State}" Width="*" />
                        <DataGridTextColumn Header="DURATION" Binding="{Binding Duration}" Width="110" />
                        <DataGridTextColumn Header="BATTERY" Binding="{Binding Battery}" Width="130" />
                        <DataGridTextColumn Header="ENERGY" Binding="{Binding Energy}" Width="100" />
                        <DataGridTextColumn Header="AVG W" Binding="{Binding Average}" Width="90" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Export CSV" Click="ExportCsv_Click" />
                <Button Content="Export report" Click="ExportReport_Click" />
                <Button Content="Export JSON" Click="ExportJson_Click" />
                <Button Content="Open data folder" Click="OpenData_Click" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AutostartButton" Content="Start with Windows" Click="Autostart_Click" />
                <Button Content="Hide to tray" Click="Hide_Click" />
            </StackPanel>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                <TextBlock Text="Theme" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox x:Name="ThemeSelector" Width="126" SelectionChanged="ThemeSelector_SelectionChanged"
                          AutomationProperties.Name="Color theme" ToolTip="System follows the Windows app appearance" />
            </StackPanel>
        </Grid>
    </Grid>
    </ScrollViewer>
</Window>
